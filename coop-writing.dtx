\cs_new_protected:Npn \__cw_set_mode:n #1
  {
    \@modoedicaofalse
    \@modosubmeterfalse
    \@modopublicarfalse
    \@modopublicaraceitandofalse
    \str_case:nnF {#1}
      {
        {editing}{\@modoedicaotrue}
        {submit}{\@modosubmetertrue}
        {publish}{\@modopublicartrue}
        {acceptingpublish}{\@modopublicartrue\@modopublicaraceitandotrue}
      }
      { \PackageError{coop-writing}{Unknown editorial mode '#1'}{Use editing, submit, publish, or acceptingpublish.} }
    \def\cw@modename{#1}
  }
\cs_new_protected:Npn \__cw_choose_mode:n #1
  {
    \int_gincr:N \g__cw_mode_option_count_int
    \int_compare:nNnT {\g__cw_mode_option_count_int} > {1}
      {\PackageWarning{coop-writing}{More than one editorial mode was requested; the last one ('#1') takes precedence}}
    \__cw_set_mode:n {#1}
  }
\__cw_set_mode:n { publish }

\cs_new_protected:Npn \__cw_set_override:Nn #1#2
  { \tl_gset:Nn #1 {#2} }

\keys_define:nn { cw/package }
  {
    mode .choice:,
    mode / editing .code:n = { \__cw_choose_mode:n {editing} },
    mode / submit .code:n = { \__cw_choose_mode:n {submit} },
