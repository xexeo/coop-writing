    \tl_clear:N \l__cw_report_status_tl
    \tl_clear:N \l__cw_report_severity_tl
    \tl_set:Nn \l__cw_report_mode_tl {detailed}
    \keys_set:nn {cw/report}{#1}
    \cw@listheading{\cwreporttitle}
    \tl_if_eq:NnTF \l__cw_report_mode_tl {summary}
      {
        \int_zero:N \l_tmpa_int
        \prop_clear:N \l__cw_report_author_prop
        \prop_clear:N \l__cw_report_type_prop
        \prop_clear:N \l__cw_report_status_prop
        \prop_clear:N \l__cw_report_severity_prop
        \seq_map_inline:Nn \g__cw_item_seq
          {
            \__cw_report_match:nT {##1}
              {
                \int_incr:N \l_tmpa_int
                \__cw_get_field:nnN {##1}{author}\l_tmpa_tl
                \__cw_get_field:nnN {##1}{type}\l_tmpb_tl
                \__cw_get_field:nnN {##1}{status}\l__cw_tmpc_tl
                \prop_get:NnNT \g__cw_decision_prop {##1} \l__cw_tmpd_tl
                  {\tl_set_eq:NN \l__cw_tmpc_tl \l__cw_tmpd_tl}
                \__cw_get_field:nnN {##1}{severity}\l__cw_tmpd_tl
                \tl_if_blank:VTF \l_tmpa_tl
                  {\__cw_report_increment:Nn \l__cw_report_author_prop {(unassigned)}}
                  {\exp_args:NNV \__cw_report_increment:Nn \l__cw_report_author_prop \l_tmpa_tl}
                \exp_args:NNV \__cw_report_increment:Nn \l__cw_report_type_prop \l_tmpb_tl
                \exp_args:NNV \__cw_report_increment:Nn \l__cw_report_status_prop \l__cw_tmpc_tl
                \exp_args:NNV \__cw_report_increment:Nn \l__cw_report_severity_prop \l__cw_tmpd_tl
              }
          }
        \par\noindent\textbf{Total:}~\int_use:N \l_tmpa_int\par
        \__cw_report_print_prop:nN {By author} \l__cw_report_author_prop
        \__cw_report_print_prop:nN {By type} \l__cw_report_type_prop
        \__cw_report_print_prop:nN {By severity} \l__cw_report_severity_prop
        \__cw_report_print_prop:nN {By status} \l__cw_report_status_prop
      }
      {
        \seq_map_inline:Nn \g__cw_item_seq
          {
            \__cw_report_match:nT {##1}
              {
                \__cw_get_field:nnN {##1}{type}\l_tmpa_tl
                \__cw_get_field:nnN {##1}{author}\l_tmpb_tl
                \__cw_get_field:nnN {##1}{status}\l__cw_tmpc_tl
                \prop_get:NnNT \g__cw_decision_prop {##1} \l__cw_tmpd_tl
                  {\tl_set_eq:NN \l__cw_tmpc_tl \l__cw_tmpd_tl}
                \__cw_get_field:nnN {##1}{severity}\l__cw_tmpd_tl
                \__cw_get_field:nnN {##1}{file}\l__cw_tmpe_tl
                \__cw_get_field:nnN {##1}{page}\l__cw_tmpf_tl
                \__cw_get_field:nnN {##1}{body}\l__cw_tmpg_tl
