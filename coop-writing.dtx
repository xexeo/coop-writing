%
% Private editorial lists.  They intentionally do not call tocloft,
% memoir's \newlistof, KOMA's tocbasic helpers, or any class-owned list API.
% This keeps coop-writing out of the document class's ToC/LoF/LoT machinery.
\newcommand{\cw@listheading}[1]{%
  \@ifundefined{chapter}{\section*{#1}}{\chapter*{#1}}%
}%
\newcommand{\cw@newlist}[3]{%
  \@ifundefined{c@#1}{\newcounter{#1}}{}%
  \@ifundefined{cft#1numwidth}{%
    \expandafter\newlength\csname cft#1numwidth\endcsname
  }{}%
  \setlength{\csname cft#1numwidth\endcsname}{\cw@cftnumwidth}%
  \expandafter\def\csname l@#1\endcsname##1##2{%
    \@dottedtocline{1}{1.5em}{\csname cft#1numwidth\endcsname}{##1}{##2}}%
  \expandafter\def\csname listof#1\endcsname{%
    \cw@listheading{#3}\@starttoc{#2}}%
}%
